<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="768.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mai.lessons.rpks.controllers.BrowserController">
   <HBox fx:id="header" prefHeight="39.0" prefWidth="1280.0" style="-fx-background-color: #CCC;">
      <children>
         <HBox fx:id="tabBar" alignment="CENTER_LEFT" fillHeight="false" prefHeight="39.0" prefWidth="1232.0">
            <children>
             <Button fx:id="addButton" contentDisplay="CENTER" ellipsisString="🞢" minHeight="25.0" minWidth="27.0" prefHeight="25.0" prefWidth="27.0" style="-fx-background-color: #ddd; -fx-background-radius: 15; -fx-text-fill: #333;" text="🞢" HBox.hgrow="NEVER">
                  <font>
                     <Font size="14.0" />
                  </font>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
                  <HBox.margin>
                     <Insets left="7.0" />
                  </HBox.margin>
                  <padding>
                     <Insets left="1.0" top="1.0" />
                  </padding>
               </Button>
            </children></HBox>
         <Button fx:id="closeAppButton" maxHeight="39.0" maxWidth="42.0" minHeight="39.0" minWidth="42.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="42.0" style="-fx-background-color: none;" text="✕">
            <font>
               <Font size="18.0" />
            </font>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
      </children></HBox>

        <TabPane fx:id="tabPane" layoutY="61.0" prefHeight="707.0" prefWidth="1280.0" tabClosingPolicy="ALL_TABS" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="61.0" />
  <HBox fx:id="hBox" layoutY="39.0" spacing="10.0" style="-fx-background-color: #ddd;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="39.0">
    <Button fx:id="backButton" minWidth="42.0" mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: none;" text="🡠" HBox.hgrow="NEVER">
         <font>
            <Font size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
    <Button fx:id="reloadButton" minWidth="36.0" prefWidth="36.0" style="-fx-background-color: none;" text="↻" HBox.hgrow="NEVER">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
    <Button fx:id="forwardButton" minWidth="42.0" mnemonicParsing="false" onAction="#goForward" style="-fx-background-color: none;" text="🡢" HBox.hgrow="NEVER">
         <font>
            <Font size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <HBox prefHeight="39.0" prefWidth="832.0" style="-fx-background-color: #fff; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
         <children>
          <TextField fx:id="urlField" onAction="#loadPageFromTextBar" promptText="Enter address" style="-fx-border-radius: 0; -fx-background-color: none;" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="18.0" />
               </font>
            </TextField>
          <Button fx:id="favoriteButton" minWidth="42.0" style="-fx-background-color: none;" text="☆" HBox.hgrow="NEVER">
               <font>
                  <Font size="18.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
    <Button contentDisplay="CENTER" minHeight="39.0" minWidth="78.0" onAction="#toggleSitePrivateMode" prefHeight="39.0" style="-fx-background-color: none; -fx-border-color: #333; -fx-border-radius: 5;" text="Private" HBox.hgrow="NEVER">
         <font>
            <Font size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <MenuBar minWidth="54.0" prefHeight="39.0" prefWidth="40.0" style="-fx-background-color: none;" HBox.hgrow="NEVER">
        <menus>
          <Menu mnemonicParsing="false" style="-fx-font-size: 18; -fx-border-radius: 5;" text="≡">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#showHistory" text="History" />
              <MenuItem mnemonicParsing="false" onAction="#selectFavorites" text="Favorites" />
              <MenuItem mnemonicParsing="false" onAction="#toggleGlobalPrivateMode" text="Private all" />
              <MenuItem mnemonicParsing="false" onAction="#saveToZip" text="Save to ZIP" />
              <MenuItem mnemonicParsing="false" onAction="#editHtml" text="View and edit HTML" />
              <MenuItem mnemonicParsing="false" onAction="#saveHistoryToXML" text="Save all history to XML" />
            </items>
          </Menu>
        </menus>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </MenuBar>
      <padding>
         <Insets bottom="10.0" top="10.0" />
      </padding>
  </HBox>
</AnchorPane>
