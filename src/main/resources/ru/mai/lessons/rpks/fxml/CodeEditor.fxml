<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="10" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mai.lessons.rpks.Controllers.CodeEditorController">
    <TextArea fx:id="codeTextArea" prefHeight="400" prefWidth="600" VBox.vgrow="ALWAYS">
      <VBox.margin>
         <Insets />
      </VBox.margin></TextArea>
    <Button onAction="#saveCode" prefHeight="26.0" prefWidth="69.0" text="Save">
      <VBox.margin>
         <Insets bottom="20.0" />
      </VBox.margin></Button>
</VBox>
