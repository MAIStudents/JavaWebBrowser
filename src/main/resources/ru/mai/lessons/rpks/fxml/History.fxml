<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mai.lessons.rpks.Controllers.HistoryController">
    <TableView fx:id="historyTable" prefHeight="401.0" prefWidth="690.0">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="urlColumn" text="URL" />
            <TableColumn fx:id="entryTimeColumn" text="Время входа" />
            <TableColumn fx:id="exitTimeColumn" text="Время на странице" />
        </columns>
    </TableView>
</VBox>
