<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="794.0" prefWidth="911.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mai.lessons.rpks.Controllers.WindowController">
    <children>
        <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <menus>
                <Menu mnemonicParsing="false" text="Страница">
                    <items>
                        <MenuItem fx:id="codeEditorBtn" mnemonicParsing="false" onAction="#codeEditor" text="Edit Source Code" />
                  <MenuItem fx:id="saveAsBtn" mnemonicParsing="false" onAction="#saveCurrentPage" text="Сохранить как..." />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Настройки">
                    <items>
                  <MenuItem fx:id="historys" mnemonicParsing="false" onAction="#showHistory" text="История" />
                  <MenuItem fx:id="liked" mnemonicParsing="false" onAction="#showLikedSites" text="Избранное" />
                  <MenuItem fx:id="privates" mnemonicParsing="false" onAction="#showPrivateSites" text="Секретики" />
                        <CustomMenuItem mnemonicParsing="false">
                            <content>
                                <CheckBox fx:id="globalPrivateModeButton" onAction="#toggleGlobalPrivateMode" style="-fx-text-fill: black;" text="Приватный режим" />
                            </content>
                        </CustomMenuItem>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <TabPane fx:id="tabPane" layoutY="70.0" prefHeight="730.0" prefWidth="911.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        </TabPane>

        <HBox prefHeight="26.0" prefWidth="879.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <children>
            <Button fx:id="leftArrow" mnemonicParsing="false" onAction="#goBackHistory" text="◀" />
            <Button fx:id="rightArrow" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#goForwardHistory" text="▶" />
                <TextField fx:id="webPath" prefWidth="30.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="goButton" mnemonicParsing="false" onAction="#openNewTab" text="GO" />
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#reloadTab" text="⟳" />
                <Button fx:id="likeButton" mnemonicParsing="false" onAction="#toggleLikeSite" text="𖹭" />
            <Button fx:id="privateModeButton" layoutX="865.0" layoutY="10.0" mnemonicParsing="false" onAction="#togglePrivateSite" prefHeight="26.0" prefWidth="36.0" text="🕶 " />
            </children>
        </HBox>
    </children>
</AnchorPane>
